// Title:   CRPx0 builds of 2026-08-02 (affiliate 21) - hash and network sweep
// Report:  reports/crpx0/2026-10-15-28685dff00aa/report.md
// Product: Microsoft Defender XDR advanced hunting
// Status:  IOC sweep. Hashes go stale fast (every build is unique); the
//          behavioural query crpx0_execution_chain.kql is the durable one.
//          Network IOCs were recovered statically and NOT contacted.
// Note:    a hit on the HTTP relay (port 8080, /relay.php) matters for
//          recovery: the malware POSTs the victim's Fernet key in that request
//          body ("decryption_key"). Pull full packet capture / proxy bodies
//          for the time window if you have them (see report, Recovery options).
let sha256s = dynamic([
    // stage 1 droppers (MalwareBazaar)
    "28685dff00aa1752b62a8580955b2530d63092bdcc0528b872a668cddad78c11",
    "bac340524549410f51b060f21abb7db30c0c5378edd2e3ac15b526e141417e89",
    "9cfe9b894af68946ddc7e6f4cbdb085a92c4009ea00554c407beb5a8fc29f6b7",
    "0dc6a5ce14838813e297a83e3c3c0868c7a211ee2da9c9705e5a282e65f089fe",
    "290d41e7436238066a8aacbd63a805aeeefc00d8798116dc702eccf6df3eae37",
    "8af1afc82c0d578a54cc34d09544a0695ec2b0d5f244bf1f1bb4993ee7614734",
    "ef431e36a8ac12051af588d800e1d8128d583a9d4c68187709263a13564081cd",
    // stage 2 installers written to %LOCALAPPDATA%\<word>.dll (decoded statically)
    "5856f684c90dba657f5cd77dd337d81fd7503b5225e1843341c1f483eebc9560",
    "5791cc18f6b0d4232cdd078c407564dda63846008dd3a36ebb116c038f009db2",
    "9ca24f98b3909366baf43a06c0060e44e4ed3adccee191bbec0e4673a651dc27",
    "ebb58e0cc4d8e081707f843508b13cc45c6f8c3dfff42f27c4fc4bc70493f0d7",
    "6e59b6c75be99a538ab4c94a17698681695c7a6a2a6cf8161a5bf4bdee1299dc",
    "2b7a4b4684c2f0e8aa41a770b94c96f2892bd1b4c56d9e9a3ed8b37c8556b983",
    "006bca7fca78e4cb9a9629c007d629d08f0ef64a58cf045860e5668b774b4539"
]);
// Network IOCs are stored defanged (lab rule) and refanged at query time.
let refang = (s:string) { replace_string(s, "[.]", ".") };
let c2_ip = refang("207.180.29[.]236");           // hxxp://207.180.29[.]236:8080/relay[.]php
let leak_domains = dynamic(["crpx0[.]su", "crpxoxo[.]pw"]);   // crpx0[.]su in this sample's note; crpxoxo[.]pw from ProVendata
let lookback = 30d;
union
    (DeviceFileEvents    | where Timestamp > ago(lookback) | where SHA256 in (sha256s)
        | project Timestamp, Source = "DeviceFileEvents", DeviceName, FileName, FolderPath, SHA256, Detail = ActionType),
    (DeviceProcessEvents | where Timestamp > ago(lookback) | where SHA256 in (sha256s)
        | project Timestamp, Source = "DeviceProcessEvents", DeviceName, FileName, FolderPath, SHA256, Detail = ProcessCommandLine),
    (DeviceNetworkEvents | where Timestamp > ago(lookback)
        | where RemoteIP == c2_ip
             or RemoteUrl has refang(tostring(leak_domains[0])) or RemoteUrl has refang(tostring(leak_domains[1]))
        | project Timestamp, Source = "DeviceNetworkEvents", DeviceName, FileName = InitiatingProcessFileName,
                  FolderPath = InitiatingProcessFolderPath, SHA256 = InitiatingProcessSHA256,
                  Detail = strcat(RemoteIP, ":", RemotePort, " ", RemoteUrl))
| order by Timestamp asc
